{
  "name": "unifilemanager/nova-file-manager",
  "description": "A disk-scoped file manager and file picker for Laravel Nova.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Sampath Arachchige",
      "role": "Maintainer"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "illuminate/filesystem": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "laravel/nova": "^4.0|^5.0",
    "unifilemanager/core": ">=0.1.4 <1.0.0"
  },
  "require-dev": {
    "laravel/pint": "^1.24",
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://nova.laravel.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "UniFileManager\\NovaFileManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UniFileManager\\NovaFileManager\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "UniFileManager\\NovaFileManager\\NovaFileManagerServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "pest --configuration=phpunit.xml --cache-directory=.pest-cache",
    "lint": "pint --test",
    "format": "pint"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
